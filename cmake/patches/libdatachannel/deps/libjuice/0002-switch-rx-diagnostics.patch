+			__atomic_fetch_add(&vkpcnx_juice_rx_bytes, (unsigned long long)ret, __ATOMIC_RELAXED);
 
 			if (agent_conn_recv(agent, buffer, (size_t)ret, &src) != 0) {
 				JLOG_WARN("Agent receive failed");
@@ -258,6 +296,9 @@ void conn_poll_process_udp(juice_agent_t *agent, struct pollfd *pfd) {
 			}
 		}
 
+		if (batch > vkpcnx_juice_rx_batch_max)
+			vkpcnx_juice_rx_batch_max = batch;
+
 		if (conn_impl->state == CONN_STATE_FINISHED)
 			return;
 
