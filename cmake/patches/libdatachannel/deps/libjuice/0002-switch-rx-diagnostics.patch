 static thread_return_t THREAD_CALL conn_thread_entry(void *arg) {
 	thread_set_name_self("juice poll");
+#ifdef __SWITCH__
+	// The socket is only drained while this thread runs, and a full kernel
+	// buffer drops packets: run ahead of the render/UI threads (priority 0x2C)
+	{
+		Result rc = svcSetThreadPriority(CUR_THREAD_HANDLE, 0x20);
+		JLOG_INFO("Poll thread priority set to 0x20: result 0x%x", (unsigned)rc);
+	}
+#endif
 	conn_registry_t *registry = (conn_registry_t *)arg;
 	conn_poll_run(registry);
 	return (thread_return_t)0;
