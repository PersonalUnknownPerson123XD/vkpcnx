+			if (vkpcnx_last_rx_ts) {
+				unsigned long long gap = (unsigned long long)(now - vkpcnx_last_rx_ts);
+				if (gap > vkpcnx_juice_rx_gap_max_ms)
+					vkpcnx_juice_rx_gap_max_ms = gap;
+			}
+			vkpcnx_last_rx_ts = now;
