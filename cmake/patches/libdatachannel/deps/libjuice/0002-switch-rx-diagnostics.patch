+// vkpcnx: socket-level receive statistics, read by the app's network diagnostics
+// (cumulative; "gap" and "batch" maxima are reset by vkpcnx_juice_take_maxima())
+volatile unsigned long long vkpcnx_juice_rx_pkts = 0;
+volatile unsigned long long vkpcnx_juice_rx_bytes = 0;
+volatile unsigned long long vkpcnx_juice_rx_batch_max = 0; // datagrams drained in one wakeup
+volatile unsigned long long vkpcnx_juice_rx_gap_max_ms = 0; // longest time between two wakeups with data
+static timestamp_t vkpcnx_last_rx_ts = 0;
+
+void vkpcnx_juice_take_maxima(unsigned long long *batch_max, unsigned long long *gap_max_ms) {
+	*batch_max = __atomic_exchange_n(&vkpcnx_juice_rx_batch_max, 0, __ATOMIC_RELAXED);
+	*gap_max_ms = __atomic_exchange_n(&vkpcnx_juice_rx_gap_max_ms, 0, __ATOMIC_RELAXED);
+}
